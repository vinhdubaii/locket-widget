<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- WinUI 3, unpackaged (no MSIX), runtime bundled so nothing else has to be installed -->
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>src\img\icon.ico</ApplicationIcon>

    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>LocketWidget</AssemblyName>
    <RootNamespace>LocketWidget</RootNamespace>
    <Version>0.1.0</Version>

    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240428000" />
    <PackageReference Include="WinUIEx" Version="2.3.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- copied next to the exe so the login window can show the app icon -->
    <Content Include="src\img\icon.ico" Link="icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
