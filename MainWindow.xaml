<Window x:Class="LocketWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Locket Widget"
        Width="220" Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Border x:Name="card"
            CornerRadius="32"
            Background="#2B2B2B"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Làm mới ngay" Click="Refresh_Click" />
                <MenuItem Header="Đăng nhập lại" Click="Relogin_Click" />
                <MenuItem x:Name="topMenu" Header="Luôn nằm trên" IsCheckable="True" Click="Top_Click" />
                <MenuItem Header="Mở thư mục dữ liệu" Click="Folder_Click" />
                <Separator />
                <MenuItem Header="Thoát" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <TextBlock x:Name="status"
                   Margin="16"
                   FontSize="12"
                   Foreground="#BBBBBB"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Text="Đang khởi động..." />
    </Border>
</Window>
